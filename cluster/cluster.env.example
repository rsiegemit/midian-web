# Site settings for the SLURM / fleet scripts under cluster/ (and the frozen scripts/ shims that point there).
# Copy to cluster/cluster.env (untracked) and fill in; cluster/env.sh sources it, and every script that submits jobs
# fails with a named error when a variable it needs is unset. Nothing under cluster/ hard-codes an account, a partition
# or a site path.
export RTE_DATA=/path/to/rte_data                 # data root: populations/, results/, cache/, env/, logs/, endpoints.d/
export RTE_REPO=/path/to/checkout                 # the checkout jobs cd into (serve_fleet / pack jobs); default $HOME/rte
export RTE_ACCOUNT=my_cpu_account                 # sbatch -A for CPU jobs (grid units, packs, ticks)
export RTE_CPU_PARTITIONS=cpu_a,cpu_requeue       # sbatch -p for one-CPU grid units
export RTE_TEST_PARTITION=test                    # sbatch -p for short driver / pack jobs
export RTE_WIDE_PARTITIONS=                       # optional: partitions a queued rerun is widened to (rerun_missing.py)
export RTE_GPU_ACCOUNT=my_gpu_account             # sbatch -A for the vLLM fleet and GPU packs
export RTE_GPU_PARTITION=gpu_h100                 # sbatch -p for the vLLM fleet and GPU packs
export RTE_CONDA_SH=/path/to/conda/etc/profile.d/conda.sh   # conda for scripts/setup (default: `conda info --base`)
# Standard SLURM variables also work for a direct `sbatch cluster/slurm/<x>.sbatch`, e.g.
#   SBATCH_ACCOUNT=$RTE_GPU_ACCOUNT SBATCH_PARTITION=$RTE_GPU_PARTITION sbatch cluster/slurm/serve_fleet.sbatch
